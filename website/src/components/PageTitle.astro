---
import compatibilityFiltersUrl from "../documentation/operation-compatibility-filters.mjs?url&no-inline";
import siteData from "../../.generated/site-data.json";

// The authoritative Markdown supplies its original H1 and fragment identity.
// Custom pages also supply their own H1. Keep Starlight's skip-link destination.
const showCompatibilityFilters = siteData.documents.some(document =>
  document.route === Astro.url.pathname && document.operationCompatibility);
---
<span id="_top" class="tabgrad-page-start" tabindex="-1"></span>
{showCompatibilityFilters && <script is:inline type="module" src={compatibilityFiltersUrl} data-operation-compatibility-script></script>}

---
import Search from "@astrojs/starlight/components/Search.astro";
import ThemeAppearance from "./ThemeAppearance.astro";
import { Icon } from "@astrojs/starlight/components";
import { runtimeVersion, repositoryUrl, packageUrl } from "../../scripts/config.mjs";

const navigation = [
  ["Get started", "/start/"],
  ["Documentation", "/docs/"],
  ["Playground", "/playground/"],
  ["Blog", "/blog/"],
  ["Versions", "/versions/"],
];
const projectNavigation = [
  ["About", "/about/"],
  ["Contact", "/contact/"],
];
const current = Astro.url.pathname;
---
<div class="tabgrad-header">
  <a href="/" class="tabgrad-brand" aria-label="Tabgrad home" aria-current={current === "/" ? "page" : undefined}>
    <img class="light-logo" src="/brand/tabgrad-logo.svg" alt="Tabgrad" width="146" height="38" />
    <img class="dark-logo" src="/brand/tabgrad-logo-dark.svg" alt="Tabgrad" width="146" height="38" />
  </a>
  <nav aria-label="Main navigation" class="tabgrad-navigation">
    {navigation.map(([label, href]) => <a
      href={href}
      aria-current={current.startsWith(href) ? "page" : undefined}
    >
      {label}
    </a>)}
  </nav>
  <div class="tabgrad-header-actions">
    <a
      class="project-icon-link header-repository"
      href={repositoryUrl}
      aria-label="Tabgrad on GitHub"
      title="Tabgrad on GitHub"
    >
      <Icon name="github" />
    </a>
    <Search />
    <div class="header-appearance" title="Change color theme">
      <ThemeAppearance />
    </div>
  </div>
  <button
    class="site-menu-toggle"
    type="button"
    popovertarget="tabgrad-site-menu"
    aria-label="Site navigation"
  >
    <span>Menu</span>
    <Icon name="bars" class="open-menu" />
    <Icon name="close" class="close-menu" />
  </button>
  <nav id="tabgrad-site-menu" class="site-menu" popover="auto" aria-label="Site navigation">
    <div class="site-menu-heading">
      <span>Explore Tabgrad</span>
      <a href="/versions/">v{runtimeVersion}</a>
    </div>
    <div class="site-menu-links">
      {navigation.map(([label, href]) => <a
        href={href}
        aria-current={current.startsWith(href) ? "page" : undefined}
      >
        {label}
      </a>)}
    </div>
    <div class="site-menu-secondary">
      {projectNavigation.map(([label, href]) => <a href={href} aria-current={current.startsWith(href) ? "page" : undefined}>
        {label}
      </a>)}
      <a href={repositoryUrl}><Icon name="github" />GitHub ↗</a>
      <a href={packageUrl}><Icon name="npm" />npm ↗</a>
    </div>
    <div class="site-menu-appearance">
      <span>Color theme</span>
      <ThemeAppearance />
    </div>
  </nav>
</div>
<script>
  import "../site-controls";
</script>

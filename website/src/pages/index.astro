---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Runner from "../components/Runner.astro";
import Illustration from "../components/Illustration.astro";
import NextStep from "../components/NextStep.astro";
import SplitSection from "../components/SplitSection.astro";
const description = "Run Python or JavaScript on CPU or GPU, directly in the browser. No computation server required.";
---
<StarlightPage frontmatter={{ title: "PyTorch code in your browser", template: "splash", description: `Nothing to install. ${description} Tabgrad independently implements a documented subset of PyTorch.`, editUrl: false }}>
  <div class="not-content marketing">
    <section class="hero">
      <div class="hero-intro">
        <div class="hero-copy">
          <h1>PyTorch code in your browser.<br /><span>Nothing to install.</span></h1>
          <div class="hero-summary">
            <p class="hero-description">{description}</p>
            <p class="hero-scope"><a href="/versions/">See supported PyTorch features</a></p>
          </div>
          <div class="action-links hero-actions">
            <a class="button primary" href="/playground/">Open playground →</a>
            <a class="text-link" href="/start/">Get started →</a>
          </div>
        </div>
        <div class="hero-art">
          <Illustration name="browser" />
        </div>
      </div>
      <div class="hero-demo">
        <Runner compact id="home" />
      </div>
    </section>
    <section class="use-cases explore-section" aria-labelledby="use-cases-title">
      <header class="section-heading">
        <div>
          <h2 id="use-cases-title">Use Tabgrad in your projects</h2>
        </div>
      </header>
      <div class="example-gallery">
        <a class="link-card" href="/docs/">
          <div class="example-card-art">
            <Illustration name="first-gradient" />
          </div>
          <h3 data-link-title>Write Python or JavaScript</h3>
          <p>Use supported PyTorch operations in Python, or work directly in JavaScript. Explore the guides and references for both languages.</p>
          <strong data-link-title>Explore the documentation →</strong>
        </a>
        <a class="link-card" href="/start/">
          <div class="example-card-art">
            <Illustration name="backends" />
          </div>
          <h3 data-link-title>Add Tabgrad to your website</h3>
          <p>Use Tabgrad in a static page or an existing application. Your visitors’ browsers do the computation.</p>
          <strong data-link-title>Get started →</strong>
        </a>
        <a class="link-card" href="/playground/?example=weighted-sum&language=javascript">
          <div class="example-card-art">
            <Illustration name="weighted-sum" />
          </div>
          <h3 data-link-title>Share runnable examples</h3>
          <p>Include a working example in an article, a lesson or a demo. Readers can change the code and see the results for themselves.</p>
          <strong data-link-title>See an example →</strong>
        </a>
      </div>
    </section>
    <SplitSection id="faq" title="Common questions" layout="stacked">
      <div class="question-list">
        <details class="disclosure content-disclosure">
          <summary>Can I use my existing PyTorch code?</summary>
          <p>You can use code that relies on the PyTorch operations Tabgrad supports. <a href="/versions/">Check compatibility</a> before adapting an existing project.</p>
        </details>
        <details class="disclosure content-disclosure">
          <summary>Can I load a pretrained model?</summary>
          <p>Loading pretrained models isn’t available in the current release. See the <a href="/versions/">supported features and current limits</a>.</p>
        </details>
        <details class="disclosure content-disclosure">
          <summary>What does “nothing to install” mean?</summary>
          <p>You can run the examples without installing Python or a development environment. Your browser downloads the files it needs, including the Python interpreter when you choose Python. See the <a href="/start/">integration examples</a>.</p>
        </details>
        <details class="disclosure content-disclosure">
          <summary>Does my code run on a server?</summary>
          <p>Tabgrad runs the calculations on your device. Your website serves the page and the files needed to run it.</p>
          <p>The playground doesn’t upload your program or tensor data. Loading the library uses the network, and code you write can make external requests. See <a href="/docs/concepts/python-in-the-browser/">how browser execution works</a>.</p>
        </details>
        <details class="disclosure content-disclosure">
          <summary>Can I use my GPU?</summary>
          <p>Choose GPU in the playground to try it. You’ll need a supported browser and device with WebGPU. Check the <a href="/versions/#execution-options">GPU requirements</a> before adding it to your own site.</p>
        </details>
      </div>
    </SplitSection>
    <NextStep
      title="Add Tabgrad to your site."
      description="Copy a complete HTML example for JavaScript or Python and adapt it to your page."
    >
      <a class="button primary" href="/start/">Get started →</a>
      <a class="text-link" href="/docs/">Read the documentation →</a>
    </NextStep>
  </div>
</StarlightPage>

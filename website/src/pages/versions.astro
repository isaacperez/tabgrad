---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import PageIntro from "../components/PageIntro.astro";
import Illustration from "../components/Illustration.astro";
import data from "../../.generated/site-data.json";
const description =
  "Check the supported operations, browser requirements and current limits before using Tabgrad in your app.";
const releases = [
  ["0.3.0", "Local Python CPU diagnostics"],
  ["0.2.0", "Managed GPU diagnostics"],
  ["0.1.3", "Release workflow improvements"],
  ["0.1.2", "Maintainer corrections"],
  ["0.1.1", "Build correction"],
  ["0.1.0", "First public distribution"],
];
if (data.release && !releases.some(([version]) => version === data.runtimeVersion))
  releases.unshift([data.runtimeVersion, `Tabgrad ${data.runtimeVersion}`]);
const currentRelease = releases.findIndex(([version]) => version === data.runtimeVersion);
if (currentRelease < 0)
  throw new Error(`Update the published release history for ${data.runtimeVersion}.`);
const previousReleases = releases.slice(currentRelease + 1);
---
<StarlightPage frontmatter={{ title: "Versions and compatibility", description, template: "splash", editUrl: false }}>
  <div class="not-content marketing">
    <PageIntro title="Versions &" accent="compatibility." description={description}>
      <Illustration slot="illustration" name="backends" />
    </PageIntro>
    <section class="current-release ink-surface">
      <div>
        <p class="release-label">Used in this playground</p>
        <h2>v{data.runtimeVersion}</h2>
        <p>Use the same version in your own page.</p>
      </div>
      <div class="next-actions">
        <a class="button primary" href="/start/">Get started →</a>
        <a
          class="text-link"
          href={`https://github.com/isaacperez/tabgrad/releases/tag/v${data.runtimeVersion}`}
        >Release notes →</a>
        <a
          class="text-link"
          href={`https://www.npmjs.com/package/@tabgrad/tabgrad/v/${data.runtimeVersion}`}
        >View on npm ↗</a>
      </div>
    </section>
    <section class="version-section" aria-labelledby="available-features">
      <h2 id="available-features">What’s available</h2>
      <p>Work with tables of numbers, combine calculations and compute their gradients. Python and JavaScript use the same supported operations.</p>
      <div class="capability-list">
        <article class="capability-row">
          <h3>Tensors & shapes</h3>
          <p>Create tensors, change their shape without copying and copy values on the same device.</p>
          <a class="text-link" href="/docs/reference/python-tensors/">Tensor reference →</a>
        </article>
        <article class="capability-row">
          <h3>Arithmetic & matrices</h3>
          <p>Add, multiply and sum tensors. Multiply 2D matrices.</p>
          <a class="text-link" href="/docs/reference/tensor-matmul/">Matrix reference →</a>
        </article>
        <article class="capability-row">
          <h3>Automatic gradients</h3>
          <p>Find how a result responds to its inputs. Compute gradients directly or accumulate them with <code>backward()</code>.</p>
          <a class="text-link" href="/docs/reference/functional-gradients/">Gradient reference →</a>
        </article>
        <article class="capability-row">
          <h3>Parameter updates</h3>
          <p>Update model parameters with basic stochastic gradient descent (SGD).</p>
          <a class="text-link" href="/docs/reference/sgd/">SGD reference →</a>
        </article>
        <article class="capability-row">
          <h3>Execution diagnostics</h3>
          <p>See executed operations, data transfers and the buffer memory Tabgrad tracks on CPU or GPU, in both JavaScript and Python.</p>
          <a class="text-link" href="/docs/reference/python-host/#read-local-runtime-observations">Diagnostics guide →</a>
        </article>
      </div>
    </section>
    <section class="version-section" aria-labelledby="execution-options">
      <h2 id="execution-options">CPU and GPU</h2>
      <p>GPU uses the browser’s WebGPU interface. Only the configurations below have been verified.</p>
      <div class="compatibility-grid">
        <article>
          <h3>CPU</h3>
          <p class="tested-environment">Default in the playground</p>
          <dl class="environment-details">
            <div>
              <dt>Tested with</dt>
              <dd>Chrome and Firefox, using the JavaScript and Python package examples.</dd>
            </div>
            <div>
              <dt>Setup</dt>
              <dd>Load Tabgrad’s versioned files from a CDN or your own site. For Python, your application also loads Pyodide, the browser’s Python interpreter.</dd>
            </div>
          </dl>
          <div class="next-actions">
            <a class="text-link" href="/docs/reference/browser-package/#use-javascript-directly-in-html">JavaScript CPU setup →</a>
            <a class="text-link" href="/docs/reference/python-host/#run-a-complete-cpu-example">Python CPU setup →</a>
          </div>
        </article>
        <article>
          <h3>GPU</h3>
          <p class="tested-environment">Choose GPU in the playground</p>
          <dl class="environment-details">
            <div>
              <dt>Tested with</dt>
              <dd>Chrome with an Apple GPU.</dd>
            </div>
            <div>
              <dt>Setup</dt>
              <dd>JavaScript needs a secure page and browser GPU support. Python also needs a same-origin worker and cross-origin isolation.</dd>
            </div>
          </dl>
          <div class="next-actions">
            <a class="text-link" href="/docs/reference/webgpu-runtime/">JavaScript GPU setup →</a>
            <a class="text-link" href="/docs/reference/python-host/#acquire-a-managed-gpu-connection">Python GPU setup →</a>
          </div>
        </article>
      </div>
    </section>
    <section class="version-section" aria-labelledby="release-limits">
      <h2 id="release-limits">Current limits</h2>
      <p>Tabgrad supports a subset of PyTorch. Loading pretrained models and fine-tuning are not supported yet.</p>
      <dl class="release-limits">
        <div>
          <dt>Data and storage</dt>
          <dd>Contiguous float32 tensors. Views reshape the whole storage without copying. No dtype conversion, arbitrary strides or cross-device transfer.</dd>
        </div>
        <div>
          <dt>Shapes and operations</dt>
          <dd>Elementwise operations require matching shapes. Matrix multiplication supports 2D inputs. No broadcasting, slicing or batched matrix products.</dd>
        </div>
        <div>
          <dt>Gradients and training</dt>
          <dd>First-order gradients and basic SGD. Higher-order gradients, momentum and weight decay are unavailable.</dd>
        </div>
        <div>
          <dt>Python API</dt>
          <dd>The official PyTorch runtime is not used. <code>torch.nn</code>, <code>torch.nn.functional</code> and activations such as <code>relu</code> are unavailable.</dd>
        </div>
      </dl>
      <p class="support-records"><a href={`https://github.com/isaacperez/tabgrad/blob/v${data.runtimeVersion}/docs/reference/release-${data.runtimeVersion}.md`}>Release support record ↗</a><a href="/docs/compatibility/">PyTorch compatibility →</a></p>
    </section>
    <section class="version-history version-section">
      <h2>Previous releases</h2>
      {previousReleases.map(([version, title]) => <a class="link-card" href={`https://github.com/isaacperez/tabgrad/releases/tag/v${version}`}>
        <strong data-link-title>{version}</strong>
        <span>{title}</span>
        <span data-link-title>Release notes ↗</span>
      </a>)}
    </section>
  </div>
</StarlightPage>

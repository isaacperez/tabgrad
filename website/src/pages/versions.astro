---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import PageIntro from "../components/PageIntro.astro";
import Illustration from "../components/Illustration.astro";
import InlineText from "../components/InlineText.astro";
import data from "../../.generated/site-data.json";
import { documentRoute } from "../../scripts/config.mjs";
const description = "Check the supported operations, browser requirements and current limits before using Tabgrad in your app.";
const release = data.releases.find(entry => entry.version === data.runtimeVersion);
if (!release?.support || !release.available) throw new Error("Selected runtime has no complete release-owned support record.");
const support = release.support;
const previousReleases = data.releases.slice(data.releases.indexOf(release) + 1);
const compatibilityByVersion = new Map(data.documents.filter(document =>
  !document.alias && document.source === "docs/compatibility.md").map(document => [document.version, document.route]));
---
<StarlightPage frontmatter={{ title: "Versions and compatibility", description, template: "splash", editUrl: false }}>
  <div class="not-content marketing">
    <PageIntro title="Versions &" accent="compatibility." description={description}>
      <Illustration slot="illustration" name="backends" />
    </PageIntro>
    <section class="current-release ink-surface">
      <div><p class="release-label">Used in this playground</p><h2>v{release.version}</h2><p>{release.title}</p></div>
      <div class="next-actions">
        <a class="button primary" href="/start/">Get started →</a>
        <a class="text-link" href={`/docs/${release.version}/`}>Documentation →</a>
        <a class="text-link" href={`https://github.com/isaacperez/tabgrad/releases/tag/v${release.version}`}>Release notes →</a>
        <a class="text-link" href={`https://www.npmjs.com/package/@tabgrad/tabgrad/v/${release.version}`}>View on npm ↗</a>
      </div>
    </section>
    <section class="version-section" aria-labelledby="available-features">
      <h2 id="available-features">What’s available</h2>
      <p><InlineText text={support.summary} /></p>
      <div class="capability-list">
        {support.capabilities.map(row => <article class="capability-row">
          <h3>{row.title}</h3><p><InlineText text={row.description} /></p>
          <a class="text-link" href={documentRoute(row.source, release.version)}>Read the guide →</a>
        </article>)}
      </div>
    </section>
    <section class="version-section" aria-labelledby="execution-options">
      <h2 id="execution-options">CPU and GPU</h2>
      <p>GPU uses the browser’s WebGPU interface. Only the configurations below have been verified for this release.</p>
      <div class="compatibility-grid">
        {support.environments.map(environment => <article>
          <h3>{environment.title}</h3><p class="tested-environment">{environment.usage}</p>
          <dl class="environment-details">
            <div><dt>Tested with</dt><dd><InlineText text={environment.tested} /></dd></div>
            <div><dt>Setup</dt><dd><InlineText text={environment.setup} /></dd></div>
          </dl>
          <div class="action-links">{environment.links.map(link => <a class="text-link" href={documentRoute(link.source, release.version) + (link.fragment ? `#${link.fragment}` : "")}>{link.label} →</a>)}</div>
        </article>)}
      </div>
    </section>
    <section class="version-section" aria-labelledby="release-limits">
      <h2 id="release-limits">Current limits</h2>
      <dl class="release-limits">
        {support.limits.map(limit => <div><dt>{limit.title}</dt><dd><InlineText text={limit.description} /></dd></div>)}
      </dl>
      <p class="support-records">
        <a href={`https://github.com/isaacperez/tabgrad/blob/v${release.version}/docs/reference/release-${release.version}.md`}>Release support record ↗</a>
        <a href={compatibilityByVersion.get(release.version)}>PyTorch compatibility →</a>
      </p>
    </section>
    <section class="version-history version-section">
      <h2>Previous releases</h2>
      {previousReleases.map(previous => <div class="release-history-entry">
        <a class="link-card" href={`https://github.com/isaacperez/tabgrad/releases/tag/v${previous.version}`}>
          <strong data-link-title>{previous.version}</strong><span>{previous.title}</span><span data-link-title>Release notes ↗</span>
        </a>
        <div class="action-links">
          <a class="text-link" href={previous.available ? `/docs/${previous.version}/` : `https://github.com/isaacperez/tabgrad/tree/${previous.sourceRevision}/docs`}>
            {previous.available ? "Documentation →" : "Source documentation ↗"}
          </a>
          {compatibilityByVersion.has(previous.version) && <a class="text-link" href={compatibilityByVersion.get(previous.version)}>PyTorch compatibility →</a>}
        </div>
      </div>)}
    </section>
  </div>
</StarlightPage>

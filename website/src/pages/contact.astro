---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Icon } from "@astrojs/starlight/components";
import PageIntro from "../components/PageIntro.astro";
import SplitSection from "../components/SplitSection.astro";
import Illustration from "../components/Illustration.astro";
import { repositoryUrl, maintainerContact } from "../../scripts/config.mjs";
---
<StarlightPage frontmatter={{ title: "Contact and professional help", description: "Contact the Tabgrad maintainer about integrations, personalised help, technical reviews and work with your team.", template: "splash", editUrl: false }}>
  <div class="not-content marketing">
    <PageIntro title="Need a hand?" accent="Let’s talk." description="Discuss an integration or explore hands-on help for your team with Tabgrad’s maintainer."><a class="button primary project-text-link" href={maintainerContact.url}><Icon name="x.com" />Find me on X ↗</a><Illustration slot="illustration" name="conversation" /></PageIntro>
    <SplitSection title="Personal guidance.">
      <p>Ask about a paid session to work through an integration, understand the supported API or review your code together.</p>
      <p>Share what you’re building, the problem you want to solve and the outcome you’re looking for. A small example is a useful starting point.</p>
    </SplitSection>
    <SplitSection title="Support for teams.">
      <p>Discuss a technical review or integration guidance for your browser application. For development work, describe the change your team needs. Sponsorship enquiries are welcome through the same contact.</p>
      <p>Availability, scope and fees are agreed directly with the maintainer.</p>
      <a class="text-link" href={maintainerContact.url}>Find {maintainerContact.label} on X ↗</a>
    </SplitSection>
    <SplitSection title="Bugs and ideas.">
      <p>Use GitHub for ordinary bugs and feature suggestions so others can find the discussion. Include a small example, what you expected and your browser version.</p>
      <p>For a possible security or privacy issue, follow the <a href={`${repositoryUrl}/security/policy`}>private reporting instructions</a>.</p>
      <a class="text-link project-text-link" href={`${repositoryUrl}/issues`}><Icon name="github" />Browse or open an issue ↗</a>
    </SplitSection>
  </div>
</StarlightPage>
